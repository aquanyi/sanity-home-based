# =============================================================================
# .htaccess — Clean & Safe Configuration for S.H.T.A
# =============================================================================

# Deny directory browsing
Options -Indexes
Options -MultiViews
ServerSignature Off

RewriteEngine On

# Redirect /index.html to /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/index\.html [NC]
RewriteRule ^ / [R=301,L]

# 1. External redirects: Redirect /page.php to /page (removes the file extension from the browser address bar)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/teacher_portal\.php [NC]
RewriteRule ^ teacher [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/admin_dashboard\.php [NC]
RewriteRule ^ admin [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/parent_portal\.php [NC]
RewriteRule ^ parent [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/accounts_dashboard\.php [NC]
RewriteRule ^ accounts [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/forgot_password\.php [NC]
RewriteRule ^ forgot-password [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/logout\.php [NC]
RewriteRule ^ logout [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/submit_enrollment\.php [NC]
RewriteRule ^ enroll [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/login\.html [NC]
RewriteRule ^ login [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/portal\.html [NC]
RewriteRule ^ portal [R=301,L]

# Exclude existing files and directories from internal rewrite rules below
# (so we don't rewrite actual images, css, js, or the redirected requests)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Friendly aliases / Internal rewrites (maps /page back to /page.php internally)
RewriteRule ^admin/?$ admin_dashboard.php [L]
RewriteRule ^parent/?$ parent_portal.php [L]
RewriteRule ^teacher/?$ teacher_portal.php [L]
RewriteRule ^accounts/?$ accounts_dashboard.php [L]
RewriteRule ^portal/?$ portal.html [L]
RewriteRule ^forgot-password/?$ forgot_password.php [L]
RewriteRule ^login/?$ login.html [L]
RewriteRule ^enroll/?$ submit_enrollment.php [L]
RewriteRule ^logout/?$ logout.php [L]

# Map any other extensionless requests internally to their .php file if it exists
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*?)/?$ $1.php [NC,L]

# Protect database credentials and sensitive files
<Files "db_connect.php">
    Order Allow,Deny
    Deny from all
</Files>
<Files "config.php">
    Order Allow,Deny
    Deny from all
</Files>
<Files "security.php">
    Order Allow,Deny
    Deny from all
</Files>
<Files "init.sql">
    Order Allow,Deny
    Deny from all
</Files>

# =============================================================================
# 3. SPEED & COMPRESSION OPTIMIZATIONS
# =============================================================================

# Enable GZIP compression for text-based resources
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml application/rss+xml image/svg+xml
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
    Header append Vary User-Agent
</IfModule>

# Enable browser caching / expires headers (cPanel Apache & LiteSpeed compatible)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # CSS and JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    
    # Images and Media
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    
    # Web Fonts
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Disable ETags to prevent browser-server validation roundtrips for cached static files
FileETag None

# =============================================================================
# 4. HTTP SECURITY HEADERS
# =============================================================================
<IfModule mod_headers.c>
    # Protect against MIME type confusion / sniffing
    Header set X-Content-Type-Options "nosniff"
    # Prevent clickjacking attacks (must load in same origin)
    Header set X-Frame-Options "SAMEORIGIN"
    # Enable browser Cross-Site Scripting (XSS) filters
    Header set X-XSS-Protection "1; mode=block"
    # Limit referrer leakages
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # Content Security Policy for secure content execution
    Header set Content-Security-Policy "default-src 'self' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https://images.unsplash.com; frame-ancestors 'none';"
</IfModule>

